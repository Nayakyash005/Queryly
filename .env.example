# Backend application settings
APP_NAME=Queryly API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Optional global SQLAlchemy database URL. Leave empty unless the backend needs it.
DATABASE_URL=

# Supabase project URL and publishable/legacy anon key (never use a service-role key here).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Groq credentials for SQL generation and repair.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=your-groq-model-name

# Optional runtime limits; these defaults are used when omitted.
QUERY_TIMEOUT_SECONDS=5
MAX_QUERY_ROWS=500
# Optional: set to an absolute trusted path. Defaults to backend/data.
# SQLITE_ALLOWED_DIRECTORY=
